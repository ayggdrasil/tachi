{
  "name": "tachi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tachi \u2014 an AI companion that keeps a senior's memories alive and connects the family.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c gray,black \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "demo": "npm run build && npm run start",
    "reset": "tsx server/scripts/reset.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test server/brain/brain.test.ts server/graph/graph.test.ts server/brain/providers/anthropic.test.ts && tsx server/scripts/flows.test.ts && tsx server/scripts/security.test.ts && tsx server/scripts/privacy3.test.ts && tsx server/scripts/p0.test.ts && tsx server/scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.1",
    "express": "^5.3.0",
    "kuzu": "^0.11.3",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
